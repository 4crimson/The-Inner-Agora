{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperclip-qa-tool.local/paperclip-qa-tool.config.schema.json",
  "title": "Paperclip QA Tool Config",
  "type": "object",
  "required": ["name", "telegram", "paperclip", "suites"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "telegram": {
      "type": "object",
      "required": ["target"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "userbot": {
          "type": "object",
          "properties": {
            "session": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "paperclip": {
      "type": "object",
      "required": ["company"],
      "properties": {
        "apiBase": { "type": "string", "minLength": 1 },
        "company": { "type": "string", "minLength": 1 },
        "cleanup": { "enum": ["hard", "soft", "none"] },
        "cleanupRunWaitAttempts": { "type": "number", "minimum": 1 },
        "cleanupRunWaitDelayMs": { "type": "number", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "dir": { "type": "string", "minLength": 1 }
      }
    },
    "guards": {
      "type": "object",
      "properties": {
        "allowWarnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "reason"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "postSuiteHealth": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "command": { "type": "string", "minLength": 1 },
            "args": {
              "type": "array",
              "items": { "type": "string" }
            },
            "timeoutMs": { "type": "number", "exclusiveMinimum": 0 },
            "runFor": { "enum": ["work-creating", "always"] }
          }
        }
      }
    },
    "reporting": {
      "type": "object",
      "properties": {
        "telegram": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "transport": { "enum": ["userbot"] },
            "sendStart": { "type": "boolean" },
            "sendResult": { "type": "boolean" },
            "retainResultMessage": { "type": "boolean" }
          }
        }
      }
    },
    "suites": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "extends": { "type": "string", "minLength": 1 },
          "tests": { "type": "array" }
        }
      }
    }
  }
}

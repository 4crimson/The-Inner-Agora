# Optional local overrides. Do not put real tokens in git.

PAPERCLIP_API_BASE=http://127.0.0.1:3100/api
INNER_AGORA_COMPANY_NAME=The Inner Agora
INNER_AGORA_PROJECT_NAME=Agora Sessions
INNER_AGORA_MODE=balanced

# Model/runtime defaults
INNER_AGORA_CODEX_MODEL=gpt-5.4
INNER_AGORA_HERMES_MODEL=google/gemma-4-26b-a4b-qat
INNER_AGORA_AGENT_ADAPTER=codex_local

# Local paths
PAPERCLIP_COCKPIT_CWD=/path/to/The Inner Agora
CODEX_CLI_PATH=/Applications/Codex.app/Contents/Resources/codex
INNER_AGORA_HERMES_COMMAND=/path/to/inneragora
INNER_AGORA_MEMORY_DIR=/path/to/The Inner Agora/memory/sessions

# Hermes profile
INNER_AGORA_HERMES_PROFILE_NAME=inneragora
INNER_AGORA_HERMES_SOURCE_PROFILE=aiboard

# Telegram bot output channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=

# Telegram userbot E2E driver. Store real values only in local env/.env.
# Load local values before QA commands with:
#   [ -f .env ] && set -a && source .env && set +a
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_PHONE=
TELEGRAM_TEST_TARGET=@crimson_philosophs_bot
TELEGRAM_USERBOT_SESSION=.telegram-userbot
TELEGRAM_USERBOT_PYTHON=.venv-telegram-userbot/bin/python
PAPERCLIP_QA_TELEGRAM_DRIVER=

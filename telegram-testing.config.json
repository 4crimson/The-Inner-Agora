{
  "name": "inner-agora-telegram-qa",
  "telegram": {
    "target": "@crimson_philosophs_bot",
    "userbot": {
      "session": ".telegram-userbot"
    }
  },
  "paperclip": {
    "apiBase": "http://127.0.0.1:3100/api",
    "company": "The Inner Agora",
    "cleanup": "hard"
  },
  "artifacts": {
    "dir": "artifacts/telegram-test-runs"
  },
  "guards": {
    "allowWarnings": [
      {
        "name": "paperclip-roster-sync-pending",
        "reason": "Allowed for dry-run planning only; live acceptance must resolve stale Paperclip roster state or record an explicit operator override."
      }
    ]
  },
  "reporting": {
    "telegram": {
      "enabled": true,
      "transport": "userbot",
      "sendStart": true,
      "sendResult": true,
      "retainResultMessage": true
    }
  },
  "suites": {
    "health": {
      "extends": "generic-health",
      "tests": [
        {
          "id": "health.telegram-userbot",
          "kind": "health",
          "expect": {
            "ok": true
          }
        }
      ]
    },
    "help": {
      "extends": "generic-telegram-help",
      "tests": [
        {
          "id": "help.ru.basic",
          "message": "агора помощь",
          "expect": {
            "paperclipRootsCreated": 0,
            "replyNotContains": ["<|channel>", "Project action exited"],
            "noRawTokens": true,
            "buttonsPresent": true
          }
        },
        {
          "id": "help.ru.capabilities",
          "message": "что ты умеешь в агоре?",
          "expect": {
            "paperclipRootsCreated": 0,
            "replyNotContains": ["<|channel>", "Project action exited"],
            "noRawTokens": true,
            "buttonsPresent": true
          }
        }
      ]
    },
    "service-commands": {
      "tests": [
        {
          "id": "service.help",
          "message": "/help",
          "expect": {
            "paperclipRootsCreated": 0,
            "replyContains": ["Я могу помочь через Агору", "обычным языком", "Текущий режим"],
            "replyNotContains": ["<|channel>", "Project action exited", "Active Agents & Tasks"],
            "noRawTokens": true,
            "buttonsPresent": true
          }
        },
        {
          "id": "service.agora.home",
          "message": "/agora",
          "expect": {
            "paperclipRootsCreated": 0,
            "replyContains": ["Я могу помочь через Агору", "обычным языком", "Текущий режим"],
            "replyNotContains": ["<|channel>", "Project action exited", "Active Agents & Tasks"],
            "noRawTokens": true,
            "buttonsPresent": true
          }
        },
        {
          "id": "service.agora.help",
          "message": "/agora help",
          "expect": {
            "paperclipRootsCreated": 0,
            "replyContains": ["Я могу помочь через Агору", "обычным языком", "Текущий режим"],
            "replyNotContains": ["<|channel>", "Project action exited", "Active Agents & Tasks"],
            "noRawTokens": true,
            "buttonsPresent": true
          }
        },
        {
          "id": "service.agents",
          "message": "/agents",
          "expect": {
            "paperclipRootsCreated": 0,
            "replyContains": ["голоса и текущие сессии", "диагностику", "Текущий режим"],
            "replyNotContains": ["<|channel>", "Project action exited", "Active Agents & Tasks"],
            "noRawTokens": true,
            "buttonsPresent": true
          }
        },
        {
          "id": "service.agora.help.full",
          "message": "/agora help full",
          "expect": {
            "paperclipRootsCreated": 0,
            "replyContains": ["Обычный вход", "Обычные команды", "Работа с сессиями", "Админ/диагностика"],
            "replyNotContains": ["<|channel>", "Project action exited", "Active Agents & Tasks"],
            "noRawTokens": true
          }
        }
      ]
    },
    "mode-routing": {
      "tests": [
        {
          "id": "mode.menu.current",
          "message": "/help",
          "expect": {
            "paperclipRootsCreated": 0,
            "replyContains": ["Текущий режим", "Сбаланс"],
            "replyNotContains": ["<|channel>", "Project action exited", "Active Agents & Tasks"],
            "noRawTokens": true,
            "buttonsPresent": true
          }
        },
        {
          "id": "mode.default-local-route",
          "message": "собери совет: как заботу не превратить в контроль [qa:<runId>]",
          "expect": {
            "paperclipRootsCreatedAtLeast": 1,
            "localRouteContains": "local",
            "replyNotContains": ["command not found", "<|channel>", "Project action exited"],
            "noRawTokens": true,
            "buttonsPresent": true
          }
        },
        {
          "id": "mode.pair-voices-local-route",
          "message": "собери совет у пары философов: как поддерживать взрослого ребенка [qa:<runId>]",
          "expect": {
            "paperclipRootsCreatedAtLeast": 1,
            "localRouteContains": "local",
            "replyNotContains": ["command not found", "<|channel>", "Project action exited"],
            "noRawTokens": true,
            "buttonsPresent": true
          }
        }
      ]
    },
    "natural-dialogue": {
      "tests": [
        {
          "id": "dialogue.freedom-adult-child",
          "message": "хочу разобраться с вопросом свободы взрослого ребенка",
          "expect": {
            "paperclipRootsCreated": 0,
            "replyNotContains": ["<|channel>", "Project action exited"],
            "noRawTokens": true
          }
        },
        {
          "id": "dialogue.ask-two-philosophers",
          "message": "а можешь спросить пару философов, но не слишком глубоко",
          "expect": {
            "replyNotContains": ["<|channel>", "Project action exited"],
            "noRawTokens": true,
            "buttonsPresent": true
          }
        },
        {
          "id": "dialogue.latest-session",
          "message": "что там по последней сессии?",
          "expect": {
            "replyNotContains": ["<|channel>", "Project action exited"],
            "noRawTokens": true,
            "buttonsPresent": true
          }
        }
      ]
    },
    "council-create": {
      "tests": [
        {
          "id": "council.quick-advice",
          "message": "быстрый совет: что такое свобода ребенка когда ему 18-20 лет [qa:<runId>]",
          "expect": {
            "paperclipRootsCreatedAtLeast": 1,
            "localRouteContains": "local",
            "replyNotContains": ["command not found", "<|channel>", "Project action exited"],
            "noRawTokens": true,
            "buttonsPresent": true
          }
        },
        {
          "id": "council.deep-care-control",
          "message": "глубокое исследование: как заботу не превратить в контроль [qa:<runId>]",
          "expect": {
            "paperclipRootsCreatedAtLeast": 1,
            "localRouteContains": "local",
            "replyNotContains": ["terminated ancestor", "<|channel>", "Project action exited"],
            "noRawTokens": true,
            "buttonsPresent": true
          }
        }
      ]
    },
    "cleanup": {
      "tests": [
        {
          "id": "cleanup.paperclip-hard-fallback",
          "kind": "cleanup",
          "expect": {
            "ok": true
          }
        },
        {
          "id": "cleanup.telegram-manifest-only",
          "kind": "cleanup",
          "expect": {
            "ok": true
          }
        }
      ]
    }
  }
}

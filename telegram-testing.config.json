{
  "name": "inner-agora-telegram-qa",
  "telegram": {
    "target": "@crimson_philosophs_bot",
    "profile": "inneragora",
    "userbot": {
      "session": ".telegram-userbot"
    }
  },
  "paperclip": {
    "apiBase": "http://127.0.0.1:3100/api",
    "company": "The Inner Agora",
    "cleanup": "hard"
  },
  "artifacts": {
    "dir": "artifacts/telegram-test-runs"
  },
  "guards": {
    "postSuiteHealth": {
      "enabled": true,
      "command": "node",
      "args": ["scripts/inner-agora-guard.mjs", "--json"],
      "timeoutMs": 90000,
      "runFor": "work-creating"
    },
    "allowWarnings": [
      {
        "name": "paperclip-roster-sync-pending",
        "reason": "Allowed for dry-run planning only; live acceptance must resolve stale Paperclip roster state or record an explicit operator override."
      }
    ]
  },
  "reporting": {
    "telegram": {
      "enabled": false,
      "transport": "userbot",
      "sendStart": false,
      "sendResult": false,
      "retainResultMessage": false
    }
  },
  "suites": {
    "health": {
      "extends": "generic-health",
      "tests": [
        {
          "id": "health.telegram-userbot",
          "kind": "health",
          "expect": {
            "ok": true
          }
        }
      ]
    },
    "help": {
      "extends": "generic-telegram-help",
      "tests": [
        {
          "id": "help.ru.basic",
          "message": "агора помощь",
          "expect": {
            "paperclipRootsCreated": 0,
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true
          }
        },
        {
          "id": "help.ru.capabilities",
          "message": "что ты умеешь в агоре?",
          "expect": {
            "paperclipRootsCreated": 0,
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true
          }
        }
      ]
    },
    "service-commands": {
      "tests": [
        {
          "id": "service.help",
          "message": "/help",
          "waitSeconds": 35,
          "expect": {
            "paperclipRootsCreated": 0,
            "replyContains": ["The Inner Agora", "философов", "обычным языком"],
            "replyNotContains": ["Текущий режим", "Режимы", "Каталог", "Все голоса", "Синтез"],
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true,
            "buttonsContain": ["Новый вопрос", "Последняя сессия", "Итог", "История", "Помощь"]
          }
        },
        {
          "id": "service.agora.home",
          "message": "/agora",
          "waitSeconds": 35,
          "expect": {
            "paperclipRootsCreated": 0,
            "replyContains": ["The Inner Agora", "философов", "обычным языком"],
            "replyNotContains": ["Текущий режим", "Режимы", "Каталог", "Все голоса", "Синтез"],
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true,
            "buttonsContain": ["Новый вопрос", "Последняя сессия", "Итог", "История", "Помощь"]
          }
        },
        {
          "id": "service.agora.help",
          "message": "/agora help",
          "waitSeconds": 35,
          "expect": {
            "paperclipRootsCreated": 0,
            "replyContains": ["The Inner Agora", "философов", "обычным языком"],
            "replyNotContains": ["Текущий режим", "Режимы", "Каталог", "Все голоса", "Синтез"],
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true,
            "buttonsContain": ["Новый вопрос", "Последняя сессия", "Итог", "История", "Помощь"]
          }
        },
        {
          "id": "service.agents",
          "message": "/agents",
          "waitSeconds": 35,
          "expect": {
            "paperclipRootsCreated": 0,
            "replyContains": ["Философы", "последней сессии"],
            "replyNotContains": ["Текущий режим", "Режимы", "Каталог", "Все голоса", "Синтез"],
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true,
            "buttonsContain": ["Последняя сессия", "Новый вопрос", "Итог", "Назад"]
          }
        },
        {
          "id": "service.agora.help.full",
          "message": "/agora help full",
          "waitSeconds": 35,
          "expect": {
            "paperclipRootsCreated": 0,
            "replyContains": ["Обычный вход", "Обычные команды", "Работа с сессиями", "Админ/диагностика"],
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true
          }
        }
      ]
    },
    "mode-routing": {
      "tests": [
        {
          "id": "mode.menu.hidden-on-help",
          "message": "/help",
          "expect": {
            "paperclipRootsCreated": 0,
            "replyContains": ["The Inner Agora", "философов"],
            "replyNotContains": ["Текущий режим", "Быстро 2", "Сбаланс. 5", "Глубоко 10", "Go/No-Go", "Все голоса"],
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true,
            "buttonsContain": ["Новый вопрос", "Последняя сессия", "Итог", "История", "Помощь"]
          }
        },
        {
          "id": "mode.default-local-route",
          "message": "собери совет: как заботу не превратить в контроль [qa:<runId>]",
          "waitSeconds": 40,
          "expect": {
            "paperclipRootsCreatedAtLeast": 1,
            "replyContains": ["Запустил совет", "Вопрос", "Философы"],
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true
          }
        },
        {
          "id": "mode.pair-voices-local-route",
          "message": "собери совет у пары философов: как поддерживать взрослого ребенка [qa:<runId>]",
          "waitSeconds": 40,
          "expect": {
            "paperclipRootsCreatedAtLeast": 1,
            "replyContains": ["Запустил совет", "Вопрос", "Философы", "Платон", "Декарт"],
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true
          }
        },
        {
          "id": "mode.custom-voices-local-route",
          "message": "собери совет с Платоном и Сартром: что такое свобода [qa:<runId>]",
          "waitSeconds": 40,
          "expect": {
            "paperclipRootsCreatedAtLeast": 1,
            "replyContains": ["Запустил совет", "Вопрос", "Философы", "Платон", "Сартр"],
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true
          }
        }
      ]
    },
    "natural-dialogue": {
      "tests": [
        {
          "id": "dialogue.freedom-adult-child",
          "message": "хочу разобраться с вопросом свободы взрослого ребенка",
          "expect": {
            "paperclipRootsCreated": 0,
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true
          }
        },
        {
          "id": "dialogue.ask-two-philosophers",
          "message": "а можешь спросить пару философов, но не слишком глубоко",
          "expect": {
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true
          }
        },
        {
          "id": "dialogue.latest-session",
          "message": "что там по последней сессии?",
          "expect": {
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true
          }
        }
      ]
    },
    "interface-contract-topics": {
      "tests": [
        {
      "id": "interface.home-menu",
      "message": "/agora",
      "waitSeconds": 35,
          "expect": {
            "paperclipRootsCreated": 0,
            "replyContains": ["The Inner Agora", "философов", "обычным языком"],
            "replyNotContains": ["Текущий режим", "Режимы", "Каталог", "Все голоса", "Синтез"],
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true,
            "buttonsContain": ["Новый вопрос", "Последняя сессия", "Итог", "История", "Помощь"]
          }
        },
        {
      "id": "interface.ambiguous-care-control-confirmation",
      "message": "хочу разобраться: как заботиться о взрослом ребенке и не превратить это в контроль",
      "waitSeconds": 35,
          "expect": {
            "paperclipRootsCreated": 0,
            "replyContains": ["Я понял тему", "Запустить"],
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true,
            "buttonsContain": ["Запустить", "Сделать быстро", "Сделать глубоко", "Выбрать философов"]
          }
        },
    {
      "id": "interface.ask-two-discipline",
      "message": "а можешь спросить пару философов про то, как отличить дисциплину от насилия над собой",
      "waitSeconds": 35,
      "expect": {
            "paperclipRootsCreatedAtLeast": 1,
            "replyContains": ["Запустил совет", "Философы", "Платон", "Декарт"],
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true
          }
        },
        {
      "id": "interface.latest-after-clean-chat",
      "message": "что там по последней сессии?",
      "waitSeconds": 35,
          "expect": {
            "paperclipRootsCreated": 0,
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true
          }
        }
      ]
    },
    "council-create": {
      "tests": [
    {
      "id": "council.quick-advice",
      "message": "коротко спроси Аристотеля и Фуко: как поддерживать взрослого ребенка, не присваивая его жизнь [qa:<runId>]",
      "waitSeconds": 40,
      "expect": {
        "paperclipRootsCreatedAtLeast": 1,
        "replyContains": ["Запустил совет", "Вопрос", "Философы", "Аристотель", "Фуко"],
        "noTechnicalFirstLevelLeak": true,
        "noRawTokens": true,
        "buttonsPresent": true
      }
    },
    {
      "id": "council.deep-care-control",
      "message": "собери совет с Джудит Батлер и Мартой Нуссбаум: как отличить дисциплину от насилия над собой [qa:<runId>]",
      "waitSeconds": 40,
      "expect": {
        "paperclipRootsCreatedAtLeast": 1,
        "replyContains": ["Запустил совет", "Вопрос", "Философы", "Батлер", "Нуссбаум"],
        "noTechnicalFirstLevelLeak": true,
        "noRawTokens": true,
        "buttonsPresent": true
      }
        },
        {
          "id": "council.custom-friendship-change",
          "message": "собери совет с Аристотелем и Фуко: можно ли дружить с человеком, которого хочешь изменить [qa:<runId>]",
          "waitSeconds": 40,
          "expect": {
            "paperclipRootsCreatedAtLeast": 1,
            "replyContains": ["Запустил совет", "Вопрос", "Философы", "Аристотель", "Фуко"],
            "noTechnicalFirstLevelLeak": true,
            "noRawTokens": true,
            "buttonsPresent": true
          }
        }
      ]
    },
    "cleanup": {
      "tests": [
        {
          "id": "cleanup.paperclip-hard-fallback",
          "kind": "cleanup",
          "expect": {
            "ok": true
          }
        },
        {
          "id": "cleanup.telegram-manifest-only",
          "kind": "cleanup",
          "expect": {
            "ok": true
          }
        }
      ]
    }
  }
}

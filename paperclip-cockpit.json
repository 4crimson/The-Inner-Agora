{
  "command": {
    "name": "agora",
    "description": "The Inner Agora cockpit for Paperclip.",
    "register_pc_fallback": false
  },
  "gateway": {
    "reset_on_gateway_shutdown": true,
    "reset_session_age_minutes": 60,
    "reset_idle_minutes": 15
  },
  "hooks": {
    "after_move": {
      "auto_finalize_parents_on_statuses": [
        "done",
        "blocked",
        "cancelled"
      ]
    }
  },
  "monitor": {
    "enabled": true,
    "state_file": ".paperclip-cockpit-monitor-state.json",
    "interval_seconds": 60,
    "max_roots": 20,
    "ignore_existing_roots": true,
    "terminal_statuses": [
      "done",
      "blocked",
      "cancelled"
    ],
    "auto_finalize_disposition_waits": {
      "enabled": true,
      "status": "done",
      "system_comment_pattern": "needs a disposition",
      "min_agent_comment_chars": 80,
      "cancel_live_runs": true,
      "force_release_after_cancel": true,
      "release_assignee_after_cancel": true,
      "clear_assignee_after_cancel": true,
      "comment": "Автоматически закрыто через Paperclip cockpit monitor: ответ агента уже есть, Paperclip ждал disposition."
    },
    "cancel_terminal_live_runs": {
      "enabled": true,
      "only_with_disposition_marker": true,
      "comment_pattern": "needs a disposition|Auto-finalized by Paperclip cockpit monitor|Автоматически закрыто через Paperclip cockpit monitor"
    },
    "synthesis_title_pattern": "^Синтез:|^Synthesis:",
    "synthesis_action": "synth",
    "launchd": {
      "label": "local.paperclip-cockpit.inneragora"
    },
    "notify": {
      "exec": [
        "node",
        "scripts/paperclip-cockpit-telegram.mjs",
        "send-result",
        "{issue}"
      ]
    },
    "progress_notify": {
      "exec": [
        "node",
        "scripts/paperclip-cockpit-telegram.mjs",
        "send-progress",
        "{root}"
      ],
      "append_args": false
    }
  },
  "issue": {
    "default_prefix": "THE"
  },
  "telegram": {
    "enabled": true,
    "profile": "inneragora",
    "callback_prefix": "pc",
    "home_chat_env": "TELEGRAM_HOME_CHANNEL",
    "buttons": {
      "enabled": true,
      "voice_limit": 6,
      "quick_actions": [
        {
          "label": "Разногласия",
          "callback": "disagreements"
        },
        {
          "label": "Углубить",
          "callback": "deepen"
        },
        {
          "label": "Новый вопрос",
          "callback": "new_question"
        }
      ],
      "labels": {
        "synthesis": "Синтез",
        "all_voices": "Все голоса",
        "export": "Экспорт",
        "clarify": "Уточнить"
      }
    },
    "help_buttons": [
      {
        "label": "Новый вопрос",
        "callback": "new_question"
      },
      {
        "label": "Уточнить",
        "callback": "clarify"
      },
      {
        "label": "Разногласия",
        "callback": "disagreements"
      },
      {
        "label": "Углубить",
        "callback": "deepen"
      }
    ],
    "command_boundary": {
      "enabled": true,
      "commands": {
        "home": [
          "/help",
          "/agora",
          "/agora help"
        ],
        "agents": [
          "/agents"
        ],
        "allow_full": [
          "/agora help full",
          "/help full",
          "/agents full"
        ]
      },
      "menus": {
        "home": {
          "text": "Я могу помочь через Агору: быстрый совет, глубокое исследование, разбор голосов и итоговый синтез.\n\nНапиши обычным языком, что хочешь понять. Если тема широкая, я уточню.",
          "buttons": [
            {
              "label": "Быстрый совет",
              "callback": "quick_prompt"
            },
            {
              "label": "Глубокое исследование",
              "callback": "deep_prompt"
            },
            {
              "label": "Codex",
              "callback": "ask_with_mode",
              "arg": "codex_deep"
            },
            {
              "label": "Выбрать философов",
              "callback": "choose_participants",
              "arg": "custom_voices"
            },
            {
              "label": "Философы",
              "callback": "philosophers_prompt"
            },
            {
              "label": "Помощь full",
              "callback": "full_help_prompt"
            }
          ]
        },
        "agents": {
          "text": "В Агоре \"агенты\" - это голоса и текущие сессии.\n\nМогу показать философов, последние сессии, прогресс или диагностику.",
          "buttons": [
            {
              "label": "Философы",
              "callback": "philosophers_prompt"
            },
            {
              "label": "Последние сессии",
              "callback": "latest_prompt"
            },
            {
              "label": "Прогресс",
              "callback": "progress_prompt"
            },
            {
              "label": "Диагностика",
              "callback": "diagnostics_prompt"
            },
            {
              "label": "Помощь",
              "callback": "full_help_prompt"
            }
          ]
        }
      }
    },
    "mode_selector": {
      "enabled": true,
      "state_path": ".paperclip-cockpit-telegram-mode-state.json",
      "default_mode": "balanced_local",
      "menus": [
        "home",
        "agents"
      ],
      "apply_to_actions": [
        "ask"
      ],
      "show_current_mode": true,
      "prompt_after_select": "Режим выбран. Теперь напиши вопрос обычным языком.",
      "choose_participants": {
        "mode": "custom_voices",
        "prompt": "Напиши имена философов и вопрос одним сообщением. Например: с Платоном и Сартром: что такое свобода."
      },
      "modes": [
        {
          "id": "quick_local",
          "label": "Быстро 2",
          "description": "короткий локальный совет",
          "action": "ask",
          "args": "--min",
          "env": {
            "INNER_AGORA_MODE": "local",
            "INNER_AGORA_FORCE_LOCAL_ADAPTER": "1"
          }
        },
        {
          "id": "balanced_local",
          "label": "Сбаланс. 5",
          "description": "локальный совет по умолчанию",
          "action": "ask",
          "args": "--balanced",
          "env": {
            "INNER_AGORA_MODE": "local",
            "INNER_AGORA_FORCE_LOCAL_ADAPTER": "1"
          }
        },
        {
          "id": "deep_local",
          "label": "Глубоко 10",
          "description": "расширенный локальный совет",
          "action": "ask",
          "args": "--max",
          "env": {
            "INNER_AGORA_MODE": "local",
            "INNER_AGORA_FORCE_LOCAL_ADAPTER": "1"
          }
        },
        {
          "id": "codex_deep",
          "label": "Codex",
          "description": "сильный разбор через codex_local",
          "action": "ask",
          "args": "--max",
          "env": {
            "INNER_AGORA_MODE": "max",
            "INNER_AGORA_FORCE_LOCAL_ADAPTER": "0"
          }
        },
        {
          "id": "all_local",
          "label": "Все голоса",
          "description": "локальный проход по всему roster",
          "action": "ask",
          "args": "--all",
          "env": {
            "INNER_AGORA_MODE": "local",
            "INNER_AGORA_FORCE_LOCAL_ADAPTER": "1"
          }
        },
        {
          "id": "custom_voices",
          "label": "Свои голоса",
          "description": "укажи философов в тексте вопроса",
          "action": "ask",
          "args": "--balanced",
          "env": {
            "INNER_AGORA_MODE": "local",
            "INNER_AGORA_FORCE_LOCAL_ADAPTER": "1"
          },
          "prompt": "Напиши имена философов и вопрос одним сообщением. Например: с Платоном и Сартром: что такое свобода."
        },
        {
          "id": "go_no_go_local",
          "label": "Go/No-Go",
          "description": "локальная управленческая палата",
          "action": "go-no-go",
          "env": {
            "INNER_AGORA_ACTIVE_CHAMBER": "board-directors",
            "INNER_AGORA_MODE": "local",
            "INNER_AGORA_FORCE_LOCAL_ADAPTER": "1"
          }
        }
      ]
    },
    "callbacks": {
      "quick_prompt": {
        "answer": "Ок",
        "message": "Напиши обычным сообщением: быстрый совет: <твой вопрос>."
      },
      "deep_prompt": {
        "answer": "Ок",
        "message": "Напиши обычным сообщением: глубокое исследование: <твой вопрос>."
      },
      "philosophers_prompt": {
        "answer": "Ок",
        "message": "Напиши обычным сообщением: покажи философов."
      },
      "latest_prompt": {
        "answer": "Ок",
        "message": "Напиши обычным сообщением: что там по последней сессии?"
      },
      "progress_prompt": {
        "answer": "Ок",
        "message": "Напиши обычным сообщением: какой прогресс по последней сессии?"
      },
      "diagnostics_prompt": {
        "answer": "Ок",
        "message": "Для диагностики используй /agora guard. Для полной справки: /agora help full."
      },
      "full_help_prompt": {
        "answer": "Ок",
        "message": "Полная справка: /agora help full."
      },
      "result": {
        "action": "telegram_result",
        "args": "{arg}",
        "answer": "Открываю синтез...",
        "telegram_payload": true
      },
      "latest": {
        "action": "telegram_latest",
        "args": "{arg}",
        "answer": "Показываю все голоса...",
        "telegram_payload": true
      },
      "voice": {
        "action": "telegram_voice",
        "args": "{arg}",
        "answer": "Открываю голос...",
        "telegram_payload": true
      },
      "export": {
        "action": "memory",
        "args": "{arg}",
        "answer": "Экспортирую..."
      },
      "clarify": {
        "answer": "Можно уточнять",
        "message": "Напиши уточнение обычным сообщением по сессии {arg}. Я подхвачу его как новый conversational запрос."
      },
      "disagreements": {
        "answer": "Ок",
        "message": "Напиши обычным сообщением: покажи главные разногласия по сессии {arg}."
      },
      "deepen": {
        "answer": "Ок",
        "message": "Напиши обычным сообщением, что именно углубить по сессии {arg}."
      },
      "new_question": {
        "answer": "Ок",
        "message": "Напиши новый вопрос обычным сообщением. Если это новая тема, начни с: новый вопрос:"
      }
    }
  },
  "notifications": {
    "comments": {
      "move_status_changed": "Статус изменен через Agora cockpit: {old_status} -> {new_status}.",
      "auto_finalized": "Пакет автоматически закрыт через Agora cockpit: все видимые дочерние задачи уже в финальных статусах."

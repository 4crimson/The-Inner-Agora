{
  "command": {
    "name": "agora",
    "description": "The Inner Agora cockpit for Paperclip.",
    "register_pc_fallback": false
  },
  "gateway": {
    "reset_on_gateway_shutdown": true,
    "reset_session_age_minutes": 60,
    "reset_idle_minutes": 15
  },
  "hooks": {
    "after_move": {
      "auto_finalize_parents_on_statuses": [
        "done",
        "blocked",
        "cancelled"
      ]
    }
  },
  "monitor": {
    "enabled": true,
    "state_file": ".paperclip-cockpit-monitor-state.json",
    "interval_seconds": 60,
    "max_roots": 20,
    "ignore_existing_roots": true,
    "terminal_statuses": [
      "done",
      "blocked",
      "cancelled"
    ],
    "auto_finalize_disposition_waits": {
      "enabled": true,
      "status": "done",
      "system_comment_pattern": "needs a disposition",
      "min_agent_comment_chars": 80,
      "cancel_live_runs": true,
      "force_release_after_cancel": true,
      "release_assignee_after_cancel": true,
      "clear_assignee_after_cancel": true,
      "comment": "Автоматически закрыто через Paperclip cockpit monitor: ответ агента уже есть, Paperclip ждал disposition."
    },
    "cancel_terminal_live_runs": {
      "enabled": true,
      "only_with_disposition_marker": true,
      "comment_pattern": "needs a disposition|Auto-finalized by Paperclip cockpit monitor|Автоматически закрыто через Paperclip cockpit monitor"
    },
    "synthesis_title_pattern": "^Синтез:|^Synthesis:",
    "synthesis_action": "synth",
    "launchd": {
      "label": "local.paperclip-cockpit.inneragora"
    },
    "notify": {
      "exec": [
        "node",
        "scripts/paperclip-cockpit-telegram.mjs",
        "send-result",
        "{issue}"
      ]
    },
    "progress_notify": {
      "exec": [
        "node",
        "scripts/paperclip-cockpit-telegram.mjs",
        "send-progress",
        "{root}"
      ],
      "append_args": false
    }
  },
  "issue": {
    "default_prefix": "THE"
  },
  "telegram": {
    "enabled": true,
    "profile": "inneragora",
    "callback_prefix": "pc",
    "home_chat_env": "TELEGRAM_HOME_CHANNEL",
    "history": {
      "defaultLimit": 5
    },
    "progress": {
      "contract_buttons": true
    },
    "error_recovery": {
      "enabled": true,
      "buttons": [
        {
          "label": "Восстановить и повторить",
          "callback": "recover_retry",
          "arg": "{arg}"
        },
        {
          "label": "Попробовать без него",
          "callback": "recover_without_philosopher",
          "arg": "{arg}"
        },
        {
          "label": "Показать детали",
          "callback": "show_error_details",
          "arg": "{arg}"
        },
        {
          "label": "Назад",
          "callback": "back_home",
          "arg": "help"
        }
      ]
    },
    "buttons": {
      "enabled": true,
      "voice_limit": 6,
      "show_export": false,
      "quick_actions": [
        {
          "label": "Новый вопрос",
          "callback": "new_question"
        },
        {
          "label": "Детали",
          "callback": "details"
        }
      ],
      "labels": {
        "synthesis": "Итог",
        "full_result": "Полный итог",
        "all_voices": "Философы",
        "clarify": "Продолжить",
        "details": "Детали"
      },
      "callbacks": {
        "all_voices": "philosophers"
      }
    },
    "help_buttons": [
      {
        "label": "Новый вопрос",
        "callback": "new_question"
      },
      {
        "label": "Последняя сессия",
        "callback": "last_session"
      },
      {
        "label": "Итог",
        "callback": "final_result"
      },
      {
        "label": "История",
        "callback": "history"
      },
      {
        "label": "Помощь",
        "callback": "help_sections"
      }
    ],
    "command_boundary": {
      "enabled": true,
      "commands": {
        "home": [
          "/start",
          "/help",
          "/agora",
          "/agora help",
          "Агора",
          "The Inner Agora"
        ],
        "agents": [
          "/agents"
        ],
        "allow_full": [
          "/agora help full",
          "/help full",
          "/agents full"
        ]
      },
      "menus": {
        "home": {
          "text": "The Inner Agora\n\nЯ могу помочь разобрать вопрос через нескольких философов.\nМожно писать обычным языком или выбрать действие.",
          "buttons": [
            {
              "label": "Новый вопрос",
              "callback": "new_question"
            },
            {
              "label": "Последняя сессия",
              "callback": "last_session"
            },
            {
              "label": "Итог",
              "callback": "final_result"
            },
            {
              "label": "История",
              "callback": "history"
            },
            {
              "label": "Помощь",
              "callback": "help_sections"
            }
          ]
        },
        "agents": {
          "text": "Философы показываются внутри активной или последней сессии.\n\nОткрой последнюю сессию или начни новый вопрос.",
          "buttons": [
            {
              "label": "Последняя сессия",
              "callback": "last_session"
            },
            {
              "label": "Новый вопрос",
              "callback": "new_question"
            },
            {
              "label": "Итог",
              "callback": "final_result"
            },
            {
              "label": "Назад",
              "callback": "back_home"
            }
          ]
        }
      }
    },
    "mode_selector": {
      "enabled": true,
      "state_path": ".paperclip-cockpit-telegram-mode-state.json",
      "default_mode": "balanced_local",
      "menus": [],
      "apply_to_actions": [
        "ask"
      ],
      "show_current_mode": true,
      "prompt_after_select": "Режим выбран. Теперь напиши вопрос обычным языком.",
      "choose_participants": {
        "mode": "custom_voices",
        "prompt": "Напиши имена философов и вопрос одним сообщением. Например: с Платоном и Сартром: что такое свобода."
      },
      "modes": [
        {
          "id": "quick_local",
          "label": "Быстро",
          "description": "короткий локальный совет",
          "action": "ask",
          "args": "--min",
          "env": {
            "INNER_AGORA_MODE": "local",
            "INNER_AGORA_FORCE_LOCAL_ADAPTER": "1"
          }
        },
        {
          "id": "balanced_local",
          "label": "Сбаланс",
          "description": "локальный совет по умолчанию",
          "action": "ask",
          "args": "--balanced",
          "env": {
            "INNER_AGORA_MODE": "local",
            "INNER_AGORA_FORCE_LOCAL_ADAPTER": "1"
          }
        },
        {
          "id": "deep_local",
          "label": "Глубоко",
          "description": "расширенный локальный совет",
          "action": "ask",
          "args": "--max",
          "env": {
            "INNER_AGORA_MODE": "local",
            "INNER_AGORA_FORCE_LOCAL_ADAPTER": "1"
          }
        },
        {
          "id": "codex_deep",
          "label": "Codex",
          "description": "сильный разбор через codex_local",
          "action": "ask",
          "args": "--max",
          "env": {
            "INNER_AGORA_MODE": "max",
            "INNER_AGORA_FORCE_LOCAL_ADAPTER": "0"
          }
        },
        {
          "id": "custom_voices",
          "label": "Свои голоса",
          "description": "укажи философов в тексте вопроса",
          "action": "ask",
          "args": "--balanced",
          "env": {
            "INNER_AGORA_MODE": "local",
            "INNER_AGORA_FORCE_LOCAL_ADAPTER": "1"
          },
          "prompt": "Напиши имена философов и вопрос одним сообщением. Например: с Платоном и Сартром: что такое свобода."
        },
        {
          "id": "go_no_go_local",
          "label": "Проверить",
          "description": "режим решения: делать или не делать, не философский совет",
          "action": "go-no-go",
          "prompt": "Напиши ситуацию практического выбора: что на столе, критерии успеха, цена ошибки и дедлайн. Ответ будет: делать, не делать или делать при условиях; с рисками и следующим шагом.",
          "env": {
            "INNER_AGORA_ACTIVE_CHAMBER": "board-directors",
            "INNER_AGORA_MODE": "local",
            "INNER_AGORA_FORCE_LOCAL_ADAPTER": "1"
          }
        }
      ]
    },
    "callbacks": {
      "quick_prompt": {
        "answer": "Ок",
        "message": "Напиши обычным сообщением: быстрый совет: <твой вопрос>."
      },
      "deep_prompt": {
        "answer": "Ок",
        "message": "Глубокое исследование.\n\nНапиши вопрос одним сообщением.\nПосле темы я предложу 5-6 философов и спрошу, запускать ли.",
        "pending_question_action": "telegram_deep_proposal",
        "telegram_payload": true,
        "buttons": [
          {
            "label": "Назад",
            "callback": "back_home"
          }
        ]
      },
      "philosophers_prompt": {
        "answer": "Ок",
        "message": "Напиши обычным сообщением: покажи философов."
      },
      "latest_prompt": {
        "answer": "Ок",
        "message": "Напиши обычным сообщением: что там по последней сессии?"
      },
      "progress_prompt": {
        "answer": "Ок",
        "message": "Напиши обычным сообщением: какой прогресс по последней сессии?"
      },
      "diagnostics_prompt": {
        "answer": "Ок",
        "message": "Для диагностики используй /agora guard. Для полной справки: /agora help full."
      },
      "full_help_prompt": {
        "answer": "Ок",
        "message": "Полная справка: /agora help full."
      },
      "result": {
        "action": "telegram_result",
        "args": "{arg}",
        "answer": "Открываю синтез...",
        "telegram_payload": true
      },
      "latest": {
        "action": "telegram_latest",
        "args": "{arg}",
        "answer": "Показываю все голоса...",
        "telegram_payload": true
      },
      "voice": {
        "action": "telegram_voice",
        "args": "{arg}",
        "answer": "Открываю голос...",
        "telegram_payload": true
      },
      "export": {
        "action": "memory",
        "args": "{arg}",
        "answer": "Экспортирую..."
      },
      "clarify": {
        "answer": "Можно уточнять",
        "message": "Продолжаем по этой сессии.\nНапиши уточнение обычным текстом.",
        "pending_question": {
          "type": "follow_up",
          "root": "{arg}"
        },
        "buttons": [
          {
            "label": "Уточнить",
            "callback": "clarify_text"
          },
          {
            "label": "Углубить",
            "callback": "deepen"
          },
          {
            "label": "Спросить философа",
            "callback": "ask_one_prompt"
          },
          {
            "label": "Новый совет по теме",
            "callback": "new_question"
          },
          {
            "label": "Завершить",
            "callback": "finish_session"
          },
          {
            "label": "Назад",
            "callback": "last_session",
            "arg": "help"
          }
        ]
      },
      "clarify_text": {
        "answer": "Ок",
        "message": "Напиши уточнение обычным текстом.\nЯ сохраню его в контексте текущей сессии {arg}.",
        "pending_question": {
          "type": "follow_up",
          "root": "{arg}"
        }
      },
      "disagreements": {
        "answer": "Ок",
        "message": "Напиши обычным сообщением: покажи главные разногласия по сессии {arg}."
      },
      "deepen": {
        "answer": "Ок",
        "message": "Напиши обычным сообщением, что именно углубить по сессии {arg}."
      },
      "philosophers": {
        "answer": "Ок",
        "action": "telegram_philosophers",
        "args": "{arg}",
        "telegram_payload": true
      },
      "philosophers_ready": {
        "answer": "Ок",
